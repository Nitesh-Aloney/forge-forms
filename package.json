{
  "name": "@alnitesh/conf-forms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev --open",
    "build": "pnpm type && rsbuild build",
    "start": "rsbuild preview",
    "lint": "biome check --write --diagnostic-level=warn",
    "prepare": "husky",
    "clean": "rm -rf node_modules dist generated",
    "type": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@mui/x-date-pickers": "^8.21.0",
    "dayjs": "^1.11.19",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.68.0",
    "swr": "^2.3.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@rsbuild/core": "^1.6.12",
    "@rsbuild/plugin-babel": "^1.0.6",
    "@rsbuild/plugin-react": "^1.4.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@8.15.9",
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --diagnostic-level=warn"
    ],
    "!(*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc})": [
      "biome check  --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=warn"
    ]
  }
}